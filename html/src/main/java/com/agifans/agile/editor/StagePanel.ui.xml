<ui:UiBinder
	xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:editor='urn:import:com.agifans.agile.editor'>

	<g:HTMLPanel>
	
		<div class="gui_stage-and-target-wrapper">
		
		    <div class="stage-wrapper_stage-wrapper" dir="ltr" ui:field="stageWrapper">
		
		        <div>
		            <div class="stage-header_stage-header-wrapper">
		                <div class="stage-header_stage-menu-wrapper">
		
		                    <div class="controls_controls-container">
		                        <g:FocusPanel ui:field="startLink">
		                            <g:HTMLPanel>
		                                <img class="green-flag_green-flag" draggable="false" src="/editor/green_flag.svg" title="Go"/>
		                            </g:HTMLPanel>
		                        </g:FocusPanel>
		                        <g:FocusPanel ui:field="pauseLink">
		                            <g:HTMLPanel>
		                                <img class="yellow-pause_yellow-pause" draggable="false" src="/editor/yellow_pause.svg" title="Pause"/>
		                            </g:HTMLPanel>
		                        </g:FocusPanel>
		                        <g:FocusPanel ui:field="playLink">
		                            <g:HTMLPanel>
		                                <img class="yellow-play_yellow-play" draggable="false" src="/editor/yellow_play.svg" title="Play"/>
		                            </g:HTMLPanel>
		                        </g:FocusPanel>
		                        <g:FocusPanel ui:field="stopLink">
		                            <g:HTMLPanel>
		                                <img class="stop-all_stop-all" draggable="false" src="/editor/red_stop.svg" title="Stop"/>
		                            </g:HTMLPanel>
		                        </g:FocusPanel>
		                    </div>
		
		                    <div class="stage-header_stage-size-row">
		                        <g:FocusPanel ui:field="smallStageLink">
		                            <g:HTMLPanel>
		                                <img class="small-stage_small-stage" draggable="false" src="/editor/small_stage.svg" title="Switch to small stage"/>
		                            </g:HTMLPanel>
		                        </g:FocusPanel>
		                        <g:FocusPanel ui:field="largeStageLink">
		                            <g:HTMLPanel>
		                                <img class="large-stage_large-stage" draggable="false" src="/editor/large_stage.svg" title="Switch to large stage"/>
		                            </g:HTMLPanel>
		                        </g:FocusPanel>
		                        <g:FocusPanel ui:field="fullScreenLink">
		                            <g:HTMLPanel>
		                                <img class="full-screen_full-screen" draggable="false" src="/editor/full_screen.svg" title="Full Screen Control"/>
		                            </g:HTMLPanel>
		                        </g:FocusPanel>
		                    </div>
		
		                </div>
		            </div>
		        </div>
		
		        <div class="stage-wrapper_stage-canvas-wrapper">
		            <div class="stage_stage-wrapper">
		                <g:HTMLPanel ui:field="agileCanvasWrapperPanel">
		                    <g:VerticalPanel ui:field="agileCanvasPanel"></g:VerticalPanel>
		                    
		                    <div class="stage_monitor-wrapper">
		                        <div class="monitor-list_monitor-list monitor-overlay" style="width: 408px; height: 306px;">
		                            <div class="monitor-list_monitor-list-scaler" style="transform: scale(0.85, 0.85);"></div>
		                        </div>
		                    </div>
		                    
		                    <div class="stage_frame-wrapper"></div>
		                </g:HTMLPanel>
		            </div>
		        </div>
		
		    </div>
		
		    <div class="gui_target-wrapper">
		    
			</div>
	
		</div>
	
	</g:HTMLPanel>
  
</ui:UiBinder>